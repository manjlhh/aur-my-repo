pkgname=zapret2
pkgver=1.0.5
pkgrel=1.1
pkgdesc="Anti-DPI software"
arch=('x86_64')
url="https://github.com/bol-van/zapret2"
license=('MIT')
depends=(
  'luajit'
  'libnetfilter_queue'
)
makedepends=('git')
provides=($pkgname)
source=($pkgname::git+$url.git#tag=v$pkgver)
sha256sums=('77fd3f59164007e9c292571349a17635fc17686cb540cf4da5a138fe152c60b5')

prepare() {
  sed -i '/^\[Service\]/ s|$|\nEnvironmentFile=-/tmp/zapret2/envvars|' "$srcdir"/$pkgname/init.d/systemd/zapret2.service
}

build() {
  cd $pkgname
  make
}

package() {
  install -Dm644 /dev/stdin "$pkgdir"/usr/lib/sysusers.d/$pkgname.conf << END
u $pkgname - "$pkgname ${pkgdesc,}"
END
  install -Dm644 /dev/stdin "$pkgdir"/usr/lib/tmpfiles.d/$pkgname.conf << END
f /opt/$pkgname/config 0664 root $pkgname
d /opt/$pkgname/files/fakes 0674 root $pkgname
d /opt/$pkgname/files/ips 0675 root $pkgname
d /opt/$pkgname/files/domains 0675 root $pkgname
END

  cd $pkgname

  install -Dm755 ipset/*  -t "$pkgdir"/opt/$pkgname/ipset/
  install -Dm644 common/* -t "$pkgdir"/opt/$pkgname/common/
  install -Dm644 lua/*    -t "$pkgdir"/opt/$pkgname/lua/
  mkdir -p -m 674 "$pkgdir"/opt/$pkgname/files/fakes
  mkdir -p -m 675 "$pkgdir"/opt/$pkgname/files/ips
  mkdir -p -m 675 "$pkgdir"/opt/$pkgname/files/domains

  install -Dm755 init.d/sysv/{functions,$pkgname} -t "$pkgdir"/opt/$pkgname/init.d/sysv/
  install -Dm644 init.d/systemd/zapret2.service -t "$pkgdir"/usr/lib/systemd/system/

  install -Dm755 binaries/my/nfqws2 -T "$pkgdir"/opt/$pkgname/nfq2/nfqws2
}
